# OFSC Instance Configuration
# Copy this file to .env.local and fill in your actual credentials

# OFSC Instance URL (without /rest at the end)
OFSC_BASE_URL=https://your-instance.ofsc.oracle.com/rest

# OFSC API Credentials
OFSC_USERNAME=your_username@your_instance_id
OFSC_PASSWORD=your_api_key_or_password

# OAuth2 Configuration (optional, if using OAuth2)
OFSC_CLIENT_ID=your_client_id
OFSC_CLIENT_SECRET=your_client_secret

# Plugin Configuration
PLUGIN_LABEL=my_custom_plugin
PLUGIN_VERSION=1.0.0

# Environment
NODE_ENV=development

# Optional: Webhook Configuration
WEBHOOK_URL=https://your-webhook-endpoint.com/ofsc
